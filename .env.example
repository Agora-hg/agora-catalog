# --- база
# Пусто или не postgres:// → dev на PGlite (.pgdata/), ставить ничего не нужно.
# На сервере — реальный Postgres.
DATABASE_URL=

# --- API
PORT=8791
# Откуда разрешены запросы. Фронт на Vercel — origin обязателен, иначе браузер
# зарежет ответы. Несколько через запятую, без слеша на конце.
CORS_ORIGINS=http://localhost:3000

# --- заявки
REQUESTS_EMAIL_TO=stanis.rum@gmail.com
SMTP_URL=
# Соль для ip_hash в аналитике. Своя на каждом окружении, в git не попадает.
IP_HASH_SALT=change-me

# --- фронт
NEXT_PUBLIC_API_URL=http://127.0.0.1:8791/v1
# Индексация. Пока сайт не на своём домене — строго false, иначе Яндекс
# проиндексирует временный адрес и после переезда мы получим дубли.
PUBLIC_INDEXABLE=false

# Коды подтверждения прав. Берутся в Яндекс.Вебмастере и Google Search Console,
# у каждого домена свои. Пустые — мета-тег не выводится.
# Номер счётчика Яндекс.Метрики. Пусто — счётчик не подключается вообще.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
