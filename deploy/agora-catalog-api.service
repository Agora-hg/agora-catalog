# /etc/systemd/system/agora-catalog-api.service
[Unit]
Description=Agora Catalog V0 API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/agora-catalog/apps/api
EnvironmentFile=/opt/agora-catalog/.env
# Запуск через tsx, а НЕ через собранный dist.
#
# Импорты внутри apps/api указывают на файлы с расширением .ts
# (`from './admin/routes.ts'`) — это рабочая схема для tsx, но она разваливается
# при компиляции в JS: в эмитированном коде импорт так и остаётся .ts, а такого
# файла рядом нет. Именно на этом упал деплой на Vercel:
#   Cannot find module '/var/task/apps/api/src/admin/routes.ts'
#   imported from /var/task/apps/api/src/app.js
# Здесь были бы те же грабли. Node 22 + tsx выполняет TypeScript напрямую.
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=5
User=www-data
Group=www-data

# Сервер общий: рядом 13 процессов PM2 чужих проектов, Postgres, MySQL, ollama.
# Лимит жёсткий, чтобы утечка в нашем приложении не уронила соседей.
MemoryMax=768M
MemoryHigh=640M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

StandardOutput=append:/var/log/agora-catalog/api.log
StandardError=append:/var/log/agora-catalog/api.err.log

[Install]
WantedBy=multi-user.target
