# На Vercel едет ТОЛЬКО фронт (apps/web).
#
# Без этого Vercel сканирует монорепо, находит apps/api и пытается поднять
# бэкенд как serverless-функцию: FUNCTION_INVOCATION_FAILED на всех маршрутах.
# Плюс по существу — в бэкенде персональные данные заявок и операторская панель,
# им место только на сервере в РФ.
#
# Это подстраховка. Основная настройка — Root Directory = apps/web
# в настройках проекта на Vercel.
apps/api
deploy
docs
packages/db/migrations
