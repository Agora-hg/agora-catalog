# Публичный URL сайта — каноникал, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3012

# База публичного API, включая /v1. Форма заявки постится СЮДА из браузера (152-ФЗ).
# Домен не хардкодить: пока не выдан — оставляем пустым и включаем MOCK_API.
NEXT_PUBLIC_API_URL=https://api.example.ru/v1

# Серверный fetch. Если пусто — берётся NEXT_PUBLIC_API_URL.
API_URL=

# 1 — не ходить в API, отдать фикстуры (бэк пишется параллельно).
MOCK_API=1

# Номер счётчика Яндекс.Метрики. Пусто — в разметке нет ни строчки.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
